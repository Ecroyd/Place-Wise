NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Usage credit top-ups (Stripe). Use test-mode keys until you're ready to take real payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: public site URL for Checkout redirects, USD→GBP rate for at-cost pricing, monthly paid ceiling in pence.
NEXT_PUBLIC_SITE_URL=
GOOGLE_USD_TO_GBP=0.80
GOOGLE_PAID_MONTHLY_CEILING_PENCE=2000
# Open routing for driving (typical traffic), walking and cycling. Results may be stored, so they're cached for OPEN_ROUTE_TTL_DAYS.
ORS_API_KEY=
# OpenRouteService base; defaults to https://api.heigit.org/openrouteservice (set for a self-hosted server)
ORS_URL=
OPEN_ROUTE_TTL_DAYS=90
# Pelias v1 base for place lookups; defaults to https://api.heigit.org/pelias/v1
ORS_GEOCODE_URL=
